local function start()
    if _G.running then 
        Library:Notify("error", 3)
        return 
    end
    
    _G.running = true

    task.spawn(function()
        task.spawn(function()
            local pgui = lp:WaitForChild("PlayerGui")
            local function cleancutscenes()
                if Library.Unloaded or not _G.running then return end
                local cine = pgui:FindFirstChild("cine") or pgui:FindFirstChild("Cutscene")
                if cine then cine:Destroy() end
                local sgui = pgui:FindFirstChild("ScreenGui")
                if sgui and sgui:FindFirstChild("BlackBars") then sgui.BlackBars:Destroy() end
                if ws.CurrentCamera.CameraType ~= Enum.CameraType.Custom then
                    ws.CurrentCamera.CameraType = Enum.CameraType.Custom
                    ws.CurrentCamera.CameraSubject = lp.Character:FindFirstChild("Humanoid")
                end
            end
            pgui.ChildAdded:Connect(cleancutscenes)
            ws.CurrentCamera:GetPropertyChangedSignal("CameraType"):Connect(cleancutscenes)
        end)

        if ws:FindFirstChild('VoidPart') == nil then 
            local aa = Instance.new('Part', ws)
            aa.Position = Vector3.new(538, 55, -231)
            aa.Name = 'VoidPart'
            aa.Size = Vector3.new(2048, 11, 2048)
            aa.Anchored = true 
            aa.Transparency = 1 
            aa.CanCollide = true 

            local ab = Instance.new('Part', aa)
            ab.Position = Vector3.new(595, 120, -330)
            ab.Name = 'Safe'
            ab.Size = Vector3.new(2000, 10, 2000)
            ab.Anchored = true 
            ab.Transparency = 0.5 
            ab.CanCollide = true 
        end

        local function hrp()
            local char = lp.Character or lp.CharacterAdded:Wait()
            return char:WaitForChild("HumanoidRootPart")
        end

        local function slapglove(target)
            local char = lp.Character
            local inventory = lp.Backpack
            if not char or not target then return end
            if inventory:FindFirstChild('Lantern') then 
                inventory:FindFirstChild('Lantern').Parent = char 
            end
            if char:FindFirstChild('Lantern') and char.Lantern:FindFirstChild('Network') then 
                char.Lantern:Activate()
                char.Lantern.Network:FireServer('Hit', target) 
            end
        end

        local function getgas()
            local count = 0
            local pipes = ws:FindFirstChild("DecontaminationPipes")
            if pipes then
                for _, pipe in pairs(pipes:GetChildren()) do
                    if pipe.Name == "pipe" and pipe:FindFirstChild("default") then
                        count = count + #pipe.default:GetChildren()
                    end
                end
            end
            return count
        end

        hrp().CFrame = CFrame.new(3258, -68, 823)
        task.wait(2)

        if Configs.collectrandhp then
            if ws:FindFirstChild('the cube of life') and ws['the cube of life']:FindFirstChild('Part') then
                hrp().CFrame = ws['the cube of life'].Part.CFrame
            end
            task.wait(0.5)
            if ws:FindFirstChild('Big Heart') then
                hrp().CFrame = ws['Big Heart'].CFrame
            end
            task.wait(1)
            if ws:FindFirstChild('ShackLever') and ws.ShackLever:FindFirstChild('Base') then
                hrp().CFrame = ws.ShackLever.Base.CFrame
            end
            task.wait(0.5)
        end

        for _, item in pairs(ws:GetDescendants()) do
            if item.Name == 'ShackLever' and item:FindFirstChild('ClickDetector') then
                fireclickdetector(item.ClickDetector, 0)
                fireclickdetector(item.ClickDetector, 1)
            end
        end

        repeat task.wait(0.1) until getgas() > 0 or Library.Unloaded or not _G.running
        repeat task.wait(0.1) until getgas() == 0 or Library.Unloaded or not _G.running
        task.wait(0.3)

        if Library.Unloaded or not _G.running then return end

        if ws.VoidPart:FindFirstChild('Safe') then 
            hrp().CFrame = ws.VoidPart.Safe.CFrame * CFrame.new(0, 25, 0) 
        end

        task.spawn(function()
            while task.wait(0.3) do
                if Library.Unloaded or not _G.running then break end
                local pgui = lp:FindFirstChild("PlayerGui")
                if pgui and pgui:FindFirstChild("Component") and pgui.Component:FindFirstChild("SpareGuidePrompt") then
                    local prompt = pgui.Component.SpareGuidePrompt
                    local targetbutton = (Configs.selectbadge == 'Relude') and prompt:FindFirstChild("Yes") or prompt:FindFirstChild("No")
                    
                    if targetbutton then
                        if firebutton1click then
                            pcall(function() firebutton1click(targetbutton) end)
                        elseif firesignal then
                            pcall(function() firesignal(targetbutton.MouseButton1Click) end)
                            pcall(function() firesignal(targetbutton.Activated) end)
                        elseif getconnections then
                            pcall(function()
                                for _, c in pairs(getconnections(targetbutton.MouseButton1Click)) do c:Fire() end
                                for _, c in pairs(getconnections(targetbutton.Activated)) do c:Fire() end
                            end)
                        end
                    end
                end
            end
        end)

        while task.wait() do
            if Library.Unloaded or not _G.running then break end
            for _, item in pairs(ws:GetChildren()) do
                if item.Name:lower() == 'trackglovemissile' then slapglove(item) end
            end
            if ws:FindFirstChild('GuideNPC') and ws.GuideNPC:FindFirstChild('HumanoidRootPart') then 
                slapglove(ws.GuideNPC.HumanoidRootPart) 
            end
            for _, item in pairs(ws:GetChildren()) do
                if item.Name:lower() == 'replicanpc' and item:FindFirstChild('HumanoidRootPart') then slapglove(item.HumanoidRootPart) end
            end
            for _, item in pairs(ws:GetChildren()) do
                if item.Name:lower() == 'golem' or item.Name:lower() == 'dungeongolem' then 
                    local targetpart = item:FindFirstChild('Hitbox') or item:FindFirstChild('Cube.001')
                    if targetpart then slapglove(targetpart) end
                end
            end
        end
    end)
end

