local kicking = false
local endReached = false

local function triggerEndKick()
    if endReached or not Toggles.kickafter.Value then return end
    endReached = true
    
    task.spawn(function()
        local timer = 0
        while timer < 30 and not kicking do
            task.wait(1)
            timer = timer + 1
        end
        
        if not kicking and Toggles.kickafter.Value then
            kicking = true
            lp:Kick("you already have a glove (gloves)")
        end
    end)
end

task.spawn(function()
    while task.wait(0.5) do
        if Toggles.kickafter.Value and not kicking then
            local cura, curr, curh = getbadges()
            local newa = cura and not initA
            local newr = curr and not initR
            local newh = curh and not initH

            if newa or newr or newh then
                kicking = true
                task.wait(1.5)
                
                cura, curr, curh = getbadges()
                newa = cura and not initA
                newr = curr and not initR
                newh = curh and not initH

                local reason = ""
                if newa and newr then
                    reason = "you got the avatar and relude glove"
                elseif newa and newh then
                    reason = "you got the avatar and hunter glove"
                elseif newa then
                    reason = "you got the avatar glove"
                elseif newr then
                    reason = "you got the relude glove"
                elseif newh then
                    reason = "you got the hunter glove"
                end
                lp:Kick(reason ~= "" and reason or "you got a glove")
                break
            end
        end
    end
end)

task.spawn(function()
