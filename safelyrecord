local function getWaveColor(phaseOffset)
	local t = (os_clock() * 3.0) + ((phaseOffset or 0) * 1.2)
	local hue = 0.51 + 0.17 * (math_sin(t) * 0.5 + 0.5)
	local sat = 0.65 + 0.35 * math_cos(t * 0.9)
	local val = 0.85 + 0.15 * math_sin(t * 1.3)
	return Color3_fromHSV(math_clamp(hue, 0.50, 0.68), math_clamp(sat, 0.55, 1), math_clamp(val, 0.75, 1))
end

