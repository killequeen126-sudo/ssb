local function rebuildTabCache()
	pcall(function()
		local pList = CoreGui:FindFirstChild("PlayerList")
		if not pList then return end

		local scroll = pList:FindFirstChild("OffsetUndoFrame", true) or pList:FindFirstChild("ScrollingFrame", true) or pList
		for _, entry in ipairs(scroll:GetDescendants()) do
			if entry:IsA("Frame") and entry.Name == MyEntryName then
				CachedGui.TabEntry = entry
				CachedGui.TabNameLabels = {}

				local nameFrame = entry:FindFirstChild("NameFrame", true)
				if nameFrame then
					for _, sub in ipairs(nameFrame:GetDescendants()) do
						if sub:IsA("TextLabel") then
							table.insert(CachedGui.TabNameLabels, sub)
						elseif sub:IsA("ImageLabel") or sub:IsA("ImageButton") then
							sub.Visible = false
							sub.ImageTransparency = 1
						end
					end
				else
					for _, sub in ipairs(entry:GetDescendants()) do
						if sub:IsA("TextLabel") and (sub.Name == "PlayerName" or sub.Text == "dante" or sub.Text == MyDisplayName or sub.Text == MyName) then
							table.insert(CachedGui.TabNameLabels, sub)
						elseif sub:IsA("ImageLabel") or sub:IsA("ImageButton") then
							sub.Visible = false
							sub.ImageTransparency = 1
						end
					end
				end

				local statSlaps = entry:FindFirstChild("GameStat_Slaps", true)
				if statSlaps then
					for _, sub in ipairs(statSlaps:GetDescendants()) do
						if sub:IsA("TextLabel") then
							sub.TextXAlignment = Enum.TextXAlignment.Center
							sub.AutomaticSize = Enum.AutomaticSize.None
							CachedGui.TabSlapLabel = sub
							break
						end
					end
				end

				local statGlove = entry:FindFirstChild("GameStat_Glove", true)
				if statGlove then
					for _, sub in ipairs(statGlove:GetDescendants()) do
						if sub:IsA("TextLabel") then
							sub.TextXAlignment = Enum.TextXAlignment.Center
							sub.AutomaticSize = Enum.AutomaticSize.None
							CachedGui.TabGloveLabel = sub
							break
						end
					end
				end
				break
			end
		end

		local dropDown = pList:FindFirstChild("PlayerDropDown", true)
		if dropDown then
			local header = dropDown:FindFirstChild("PlayerHeader", true)
			if header then
				CachedGui.DropDownAvatar = header:FindFirstChild("AvatarImage", true)
				local textContainer = header:FindFirstChild("TextContainerFrame", true)
				if textContainer then
					CachedGui.DropDownDisplay = textContainer:FindFirstChild("DisplayName", true)
					CachedGui.DropDownUser = textContainer:FindFirstChild("PlayerName", true)
				end
			end
			CachedGui.InspectBtn = dropDown:FindFirstChild("InspectButton", true)
		end
	end)
end
rebuildTabCache()

local function scanAndSpoofEscMenu()
	pcall(function()
		local inGameMenu = CoreGui:FindFirstChild("InGameMenu") or CoreGui:FindFirstChild("RobloxGui")
		if not inGameMenu then return end

		for _, item in ipairs(inGameMenu:GetDescendants()) do
			if item:IsA("ImageLabel") or item:IsA("ImageButton") then
				local img = tostring(item.Image or "")
				if str_find(img, MyUserIdStr, 1, true) then
					item.ImageTransparency = 1
					item.Visible = false
				end
			elseif item:IsA("Frame") or item:IsA("CanvasGroup") then
				local isLocalCard = false
				for _, sub in ipairs(item:GetChildren()) do
					if sub:IsA("TextLabel") and (sub.Text == CurrentValues.Name or sub.Text == "@" .. CurrentValues.Name or sub.Text == MyName or sub.Text == MyDisplayName or sub.Text == "@" .. MyName) then
						isLocalCard = true
						break
					end
				end
				if not isLocalCard then
					for _, sub in ipairs(item:GetDescendants()) do
						if sub:IsA("TextLabel") and (sub.Text == CurrentValues.Name or sub.Text == "@" .. CurrentValues.Name or sub.Text == MyName or sub.Text == MyDisplayName or sub.Text == "@" .. MyName) then
							isLocalCard = true
							break
						end
					end
				end

				if isLocalCard then
					for _, sub in ipairs(item:GetDescendants()) do
						if (sub:IsA("ImageLabel") or sub:IsA("ImageButton")) and (str_find(str_lower(sub.Name), "avatar") or str_find(str_lower(sub.Name), "head") or str_find(str_lower(sub.Name), "thumbnail") or str_find(tostring(sub.Image), MyUserIdStr)) then
							sub.ImageTransparency = 1
							sub.Visible = false
						elseif sub:IsA("ViewportFrame") then
							sub.Visible = false
						end
					end
				end
			end
		end
	end)
end

local function updateFastSpoof()
	local cName = getWaveColor(3.0)
	local cSlaps = getWaveColor(4.5)
	local cGlove = getWaveColor(6.0)
	local cTool = getWaveColor(12.0)

	local sValName = CurrentValues.Name
	local sValSlaps = CurrentValues.Slaps
	local sValGlove = CurrentValues.Glove
	local sValOverhead = CurrentValues.Overhead
	local sValTool = CurrentValues.Tool

	local myLs = LP:FindFirstChild("leaderstats")
	if myLs then
		local sObj = myLs:FindFirstChild("Slaps")
		if sObj then
			pcall(function()
				if sObj:IsA("IntValue") or sObj:IsA("NumberValue") then sObj.Value = CurrentValues.SlapsNum
				elseif sObj:IsA("StringValue") then sObj.Value = sValSlaps end
			end)
		end
		local gObj = myLs:FindFirstChild("Glove")
		if gObj and gObj:IsA("StringValue") then
			pcall(function() gObj.Value = sValGlove end)
		end
	end

	local eq = LP:FindFirstChild("Equipped")
	if eq and eq:IsA("StringValue") then
		pcall(function() eq.Value = sValTool end)
	end
	local ib = LP:FindFirstChild("ItemsBag")
	if ib then
		for _, item in ipairs(ib:GetChildren()) do
			pcall(function() item.Name = sValTool end)
		end
	end

	local backpack = LP:FindFirstChildOfClass("Backpack")
	if backpack then
		for _, tool in ipairs(backpack:GetChildren()) do
			pcall(function()
				if tool.Name ~= sValTool then tool.Name = sValTool end
				if tool:IsA("Tool") then tool.ToolTip = sValTool end
			end)
		end
	end

	local char = LP.Character
	if char then
		for _, item in ipairs(char:GetChildren()) do
			if item:IsA("Accessory") or item:IsA("Clothing") or item:IsA("ShirtGraphic") or item:IsA("BodyColors") or item:IsA("CharacterMesh") then
				pcall(function() item:Destroy() end)
			elseif item:IsA("Tool") then
				pcall(function()
					if item.Name ~= sValTool then item.Name = sValTool end
					item.ToolTip = sValTool
				end)
				for _, part in ipairs(item:GetDescendants()) do
					if part:IsA("BasePart") then
						part.Color = cTool
						part.Material = Enum.Material.SmoothPlastic
					end
				end
			elseif item:IsA("BasePart") then
				item.Material = Enum.Material.SmoothPlastic
				item.Color = cTool
				if item.Name == "Head" then
					local face = item:FindFirstChild("face")
					if face then face.Transparency = 1 end
				end
			end
		end
	end

	for i = #CachedGui.CharacterParts, 1, -1 do
		local p = CachedGui.CharacterParts[i]
		if p and p.Parent then
			p.Color = cTool
			p.Material = Enum.Material.SmoothPlastic
		else
			table.remove(CachedGui.CharacterParts, i)
		end
	end

	for i = #CachedGui.OverheadLabels, 1, -1 do
		local lbl = CachedGui.OverheadLabels[i]
		if lbl and lbl.Parent then
			local txt = lbl.Text
			if str_find(txt, "%+") then
				lbl.Visible = false
			elseif txt == MyName or txt == MyDisplayName or str_find(txt, MyName, 1, true) or str_find(txt, MyDisplayName, 1, true) or tonumber(txt) ~= nil or txt == "dante" then
				lbl.Text = sValOverhead
				lbl.TextColor3 = cName
			end
		else
			table.remove(CachedGui.OverheadLabels, i)
		end
	end

	if not CachedGui.TabEntry or not CachedGui.TabEntry.Parent then
		rebuildTabCache()
	end

	if CachedGui.TabEntry and CachedGui.TabEntry.Parent then
		if CachedGui.TabEntry.LayoutOrder ~= 2147483647 then
			CachedGui.TabEntry.LayoutOrder = 2147483647
		end

		for _, lbl in ipairs(CachedGui.TabNameLabels) do
			if lbl and lbl.Parent then
				lbl.Text = sValName
				lbl.TextColor3 = cName
			end
		end

		if CachedGui.TabSlapLabel and CachedGui.TabSlapLabel.Parent then
			CachedGui.TabSlapLabel.Text = sValSlaps
			CachedGui.TabSlapLabel.TextColor3 = cSlaps
		end

		if CachedGui.TabGloveLabel and CachedGui.TabGloveLabel.Parent then
			CachedGui.TabGloveLabel.Text = sValGlove
			CachedGui.TabGloveLabel.TextColor3 = cGlove
		end
	end

	if CachedGui.DropDownAvatar and CachedGui.DropDownAvatar.Parent then
		CachedGui.DropDownAvatar.ImageTransparency = 1
		CachedGui.DropDownAvatar.BackgroundTransparency = 1
	end
	if CachedGui.DropDownDisplay and CachedGui.DropDownDisplay.Parent then
		CachedGui.DropDownDisplay.Text = CurrentValues.DropDownDisplay
		CachedGui.DropDownDisplay.TextColor3 = getWaveColor(7.5)
	end
	if CachedGui.DropDownUser and CachedGui.DropDownUser.Parent then
		CachedGui.DropDownUser.Text = "@" .. CurrentValues.DropDownUser
		CachedGui.DropDownUser.TextColor3 = getWaveColor(9.0)
	end
	if CachedGui.InspectBtn and CachedGui.InspectBtn.Parent then
		CachedGui.InspectBtn.Visible = false
	end
end

local lastEscScan = 0
RunService.RenderStepped:Connect(function()
	local now = os_clock()
	if now - lastUpdateTime >= UPDATE_INTERVAL then
		lastUpdateTime = now
		generateRandomValues()
	end

	updateFastSpoof()

	if now - lastEscScan >= 0.5 then
		lastEscScan = now
		scanAndSpoofEscMenu()
	end
end)
