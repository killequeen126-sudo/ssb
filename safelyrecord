local function cleanOverheadIcons(char)
	if not char then return end
	for _, item in ipairs(char:GetDescendants()) do
		if item:IsA("ImageLabel") or item:IsA("ImageButton") then
			pcall(function()
				item.Visible = false
				item.ImageTransparency = 1
				item:Destroy()
			end)
		end
	end
end

local function applyBlockySkin(char)
	if not char then return end
	local skinCol = getWaveColor(12.0)

	for _, item in ipairs(char:GetChildren()) do
		if item:IsA("Accessory") or item:IsA("Clothing") or item:IsA("ShirtGraphic") or item:IsA("BodyColors") then
			pcall(function()
				if item:IsA("Accessory") then
					local handle = item:FindFirstChild("Handle")
					if handle then handle.Transparency = 1 end
					item:Destroy()
				else
					item:Destroy()
				end
			end)
		elseif item:IsA("CharacterMesh") then
			pcall(function() item:Destroy() end)
		elseif item:IsA("BasePart") then
			if item.Name == "Head" then
				local mesh = item:FindFirstChildOfClass("SpecialMesh")
				if mesh then
					mesh.MeshType = Enum.MeshType.Head
					mesh.TextureId = ""
				end
				local face = item:FindFirstChild("face")
				if face then face.Transparency = 1 end
			end
			item.Material = Enum.Material.SmoothPlastic
			item.Color = skinCol
		end
	end
end

local function hookCharacter(char)
	if not char then return end

	CachedGui.OverheadLabels = {}
	CachedGui.CharacterParts = {}

	applyBlockySkin(char)
	cleanOverheadIcons(char)

	for _, item in ipairs(char:GetDescendants()) do
		if item:IsA("ImageLabel") or item:IsA("ImageButton") then
			pcall(function()
				item.Visible = false
				item.ImageTransparency = 1
				item:Destroy()
			end)
		elseif item:IsA("BillboardGui") and (str_find(str_lower(item.Name), "slap") or str_find(str_lower(item.Name), "gain") or str_find(str_lower(item.Name), "pop") or str_find(str_lower(item.Name), "count")) then
			item.Enabled = false
			pcall(function() item:Destroy() end)
		elseif item:IsA("TextLabel") then
			table.insert(CachedGui.OverheadLabels, item)
		elseif item:IsA("BasePart") then
			table.insert(CachedGui.CharacterParts, item)
		end
	end

	char.DescendantAdded:Connect(function(child)
		if child:IsA("Accessory") or child:IsA("Clothing") or child:IsA("ShirtGraphic") or child:IsA("BodyColors") or child:IsA("CharacterMesh") then
			task.defer(function()
				pcall(function()
					if child:IsA("Accessory") then
						local handle = child:FindFirstChild("Handle")
						if handle then handle.Transparency = 1 end
					end
					child:Destroy()
				end)
			end)
		elseif child:IsA("Decal") and child.Name == "face" then
			task.defer(function()
				pcall(function() child.Transparency = 1 end)
			end)
		elseif child:IsA("ImageLabel") or child:IsA("ImageButton") then
			task.defer(function()
				pcall(function()
					child.Visible = false
					child.ImageTransparency = 1
					child:Destroy()
				end)
			end)
		elseif child:IsA("BillboardGui") then
			task.defer(function()
				for _, sub in ipairs(child:GetDescendants()) do
					if sub:IsA("TextLabel") and (str_find(sub.Text, "%+") or str_find(str_lower(sub.Text), "slap") or str_find(str_lower(sub.Text), "gain")) then
						child.Enabled = false
						child:Destroy()
						break
					end
				end
			end)
		elseif child:IsA("TextLabel") then
			table.insert(CachedGui.OverheadLabels, child)
		elseif child:IsA("BasePart") then
			child.Material = Enum.Material.SmoothPlastic
			table.insert(CachedGui.CharacterParts, child)
		end
	end)
end

if LP.Character then hookCharacter(LP.Character) end
