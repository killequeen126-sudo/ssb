local function sanitizeBadgeLabel(item)
	if not item:IsA("TextLabel") then return end
	local txt = item.Text
	if not txt or txt == "" then return end
	if str_find(txt, MyName, 1, true) or str_find(txt, MyDisplayName, 1, true) or str_find(txt, "dante", 1, true) then
		local newTxt = str_gsub(txt, MyName, CurrentValues.Name)
		newTxt = str_gsub(newTxt, MyDisplayName, CurrentValues.Name)
		newTxt = str_gsub(newTxt, "dante", CurrentValues.Name)
		item.Text = newTxt
		item.TextColor3 = getWaveColor(1.5)
	end
end

pcall(function()
	CoreGui.DescendantAdded:Connect(function(child)
		if child:IsA("TextLabel") then
			task.defer(function()
				sanitizeBadgeLabel(child)
				child:GetPropertyChangedSignal("Text"):Connect(function()
					sanitizeBadgeLabel(child)
				end)
			end)
		elseif child:IsA("ImageLabel") or child:IsA("ImageButton") then
			task.defer(function()
				if str_find(tostring(child.Image or ""), MyUserIdStr, 1, true) then
					child.ImageTransparency = 1
					child.Visible = false
				end
			end)
		end
	end)
end)

local function hideSlapCounterGuiElement(item)
	local name = str_lower(item.Name)
	if str_find(name, "slapcounter") or str_find(name, "slap_counter") or str_find(name, "slapcount") or str_find(name, "slapmeter") or (str_find(name, "counter") and item.Parent and str_find(str_lower(item.Parent.Name), "slap")) then
		pcall(function()
			if item:IsA("ScreenGui") then
				item.Enabled = false
			elseif item:IsA("GuiObject") then
				item.Visible = false
			end
		end)
	end

	if item:IsA("TextLabel") then
		local txt = item.Text or ""
		local lTxt = str_lower(txt)
		if str_find(txt, "%+") or str_find(lTxt, "slaps%s*enabled") or str_find(lTxt, "slap%s*enabled") or str_find(lTxt, "%dx") or str_find(lTxt, "x%d") or str_find(lTxt, "multiplier") then
			item.Visible = false
			item.TextTransparency = 1
		elseif str_find(name, "slap") and str_find(name, "counter") then
			item.Visible = false
			item.TextTransparency = 1
		end
	elseif item:IsA("ImageLabel") or item:IsA("ImageButton") then
		if str_find(name, "slap") and (str_find(name, "hand") or str_find(name, "icon") or str_find(name, "meter") or str_find(name, "counter")) then
			item.Visible = false
			item.ImageTransparency = 1
		end
	end
end

local function cleanAllSlapCounters()
	for _, item in ipairs(PlayerGui:GetDescendants()) do
		hideSlapCounterGuiElement(item)
		if item:IsA("TextLabel") then
			local txt = item.Text or ""
			if txt == MyName or txt == MyDisplayName or txt == "dante" or str_find(txt, MyName, 1, true) or str_find(txt, MyDisplayName, 1, true) then
				item.Text = CurrentValues.Name
				item.TextColor3 = getWaveColor(1.5)
			elseif str_find(str_lower(txt), "glove:", 1, true) or str_find(str_lower(txt), "equipped:", 1, true) then
				item.Text = "Glove: " .. CurrentValues.Glove
				item.TextColor3 = getWaveColor(1.5)
			end
		end
	end
end
